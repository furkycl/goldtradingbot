# Copy to .env and fill in. NEVER commit .env.

# --- Live trading switch (in addition to mode: live in settings.yaml) ---
# GOLDBOT_LIVE_CONFIRM="I UNDERSTAND I CAN LOSE ALL MY MONEY"

# --- MT5 broker ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# --- Tokenised gold on a crypto exchange (ccxt) ---
CCXT_EXCHANGE=
CCXT_API_KEY=
CCXT_SECRET=

# --- Telegram: read news channels (https://my.telegram.org) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Telegram: notifications to your phone (@BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
